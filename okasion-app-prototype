const BACKUP=["https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=800&h=1000&q=80", "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=800&h=1000&q=80", "https://images.unsplash.com/photo-1529626455594-4ff0802cfb7e?auto=format&fit=crop&w=800&h=1000&q=80", "https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=800&h=1000&q=80", "https://images.unsplash.com/photo-1508214751196-bcfd4ca60f91?auto=format&fit=crop&w=800&h=1000&q=80", "https://images.unsplash.com/photo-1469334031218-e382a71b716b?auto=format&fit=crop&w=800&h=1000&q=80", "https://images.unsplash.com/photo-1488426862026-3ee34a7d66df?auto=format&fit=crop&w=800&h=1000&q=80", "https://images.unsplash.com/photo-1542038784456-1ea8e935640e?auto=format&fit=crop&w=800&h=1000&q=80", "https://images.unsplash.com/photo-1523438885200-e635ba2c371e?auto=format&fit=crop&w=800&h=1000&q=80", "https://images.unsplash.com/photo-1519167758481-83f550bb49b3?auto=format&fit=crop&w=800&h=1000&q=80", "https://images.unsplash.com/photo-1530103862676-de8c9debad1d?auto=format&fit=crop&w=800&h=1000&q=80", "https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=800&h=1000&q=80"];
const PIN=`<svg viewBox="0 0 24 24" class="pin"><path d="M12 22s7-6.5 7-12a7 7 0 0 0-14 0c0 5.5 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg>`;
const s1=document.getElementById('s1'),s2=document.getElementById('s2'),s3=document.getElementById('s3'),s4=document.getElementById('s4'),s5=document.getElementById('s5'),s6=document.getElementById('s6');
const stack=document.getElementById('stack'),counter=document.getElementById('counter'),toast=document.getElementById('toast');
const evt=document.getElementById('evt'),err=document.getElementById('err');
let svc=null,deck=[],idx=0,likes=[],history=[],busy=false;
let bi=0;function onFail(img){if(bi<BACKUP.length){img.src=BACKUP[bi++];}else{img.style.visibility='hidden';}}
document.querySelectorAll('img').forEach(i=>i.addEventListener('error',()=>onFail(i)));

document.querySelectorAll('#svc .chip').forEach(c=>c.addEventListener('click',()=>{
  document.querySelectorAll('#svc .chip').forEach(x=>x.setAttribute('aria-checked','false'));
  c.setAttribute('aria-checked','true');svc=c.dataset.svc;err.textContent='';
}));
function show(s){[s1,s2,s3,s4,s5,s6].forEach(x=>x.classList.remove('active'));s.classList.add('active');}
document.getElementById('go').addEventListener('click',()=>{
  if(!evt.value.trim()){err.textContent='Tell us the event first.';evt.focus();return;}
  if(!svc){err.textContent='Pick who you need.';return;}
  buildDeck();show(s2);
});
document.getElementById('back').addEventListener('click',()=>show(s1));

function buildDeck(){
  const primary=PROFILES.filter(p=>p.role===svc),rest=PROFILES.filter(p=>p.role!==svc);
  deck=[...primary,...rest];idx=0;likes=[];history=[];
  document.getElementById('svcTitle').textContent=svc;
  document.getElementById('evtTitle').textContent='for your '+evt.value.trim().toLowerCase();
  render();
}
function fit(p){return 84+((p.handle.length*7)%15);}
function cardEl(p,pos){
  const el=document.createElement('article');el.className='card'+(pos?' pos'+pos:'');
  el.innerHTML=`<div class="ph"><img src="${p.img}" alt="${p.role} portfolio by ${p.handle}" draggable="false"><div class="fit"><i></i>${fit(p)}% style fit</div><div class="rate">from ${p.rate}</div><div class="stamp like">MATCH</div><div class="stamp nope">PASS</div></div>
  <div class="cap"><div class="row"><h2>${p.handle}</h2><span class="loc">${PIN}${p.loc}</span></div><div class="role">${p.role}</div><div class="tags">${p.tags.map(t=>`<span class="tag${p.role===svc?' hit':''}">${t}</span>`).join('')}</div><button class="more" data-open>view portfolio &amp; rates <svg viewBox="0 0 24 24"><path d="M6 15l6-6 6 6"/></svg></button></div>`;
  el.querySelector('[data-open]').addEventListener('click',e=>{e.stopPropagation();openSheet(p);});
  el.querySelector('img').addEventListener('error',e=>onFail(e.target));
  if(pos===0)drag(el);
  return el;
}
function render(){
  stack.innerHTML='';
  if(idx>=deck.length){stack.innerHTML='<div class="empty">That\'s everyone on the board for now. Check back tomorrow, or widen your filters.</div>';counter.textContent='';if(likes.length)finale();return;}
  for(let pos=2;pos>=0;pos--){const p=deck[idx+pos];if(p)stack.appendChild(cardEl(p,pos));}
  counter.textContent=`${idx+1} / ${deck.length} · ${likes.length} liked`;
}
function swipe(dir){
  if(busy||idx>=deck.length)return;busy=true;
  const top=stack.querySelector('.card:not(.pos1):not(.pos2)');if(!top){busy=false;return;}
  top.classList.remove('dragging');top.style.transform='';
  top.querySelector(dir>0?'.stamp.like':'.stamp.nope').style.opacity=1;
  top.classList.add(dir>0?'gone-r':'gone-l');
  const p=deck[idx];history.push({i:idx,liked:dir>0});
  if(dir>0)likes.push(p);
  setTimeout(()=>{idx++;busy=false;if(dir>0&&likes.length===3){render();finale();}else render();},380);
}
document.getElementById('like').addEventListener('click',()=>swipe(1));
document.getElementById('pass').addEventListener('click',()=>swipe(-1));
document.getElementById('undo').addEventListener('click',()=>{if(busy||!history.length)return;const h=history.pop();idx=h.i;if(h.liked)likes.pop();render();ping('Brought back '+deck[idx].handle);});
document.getElementById('filter').addEventListener('click',()=>ping('Filters: '+svc+' · '+evt.value.trim()+' · Metro Manila'));
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeSheet();if(!s2.classList.contains('active')||sheet.classList.contains('open'))return;if(e.key==='ArrowRight')swipe(1);if(e.key==='ArrowLeft')swipe(-1);});
function ping(t){toast.textContent=t;toast.classList.add('show');clearTimeout(ping.t);ping.t=setTimeout(()=>toast.classList.remove('show'),1600);}

function drag(el){
  let sx=0,dx=0,down=false;
  el.addEventListener('pointerdown',e=>{if(busy||e.target.closest('[data-open]'))return;down=true;sx=e.clientX;el.setPointerCapture(e.pointerId);el.classList.add('dragging');});
  el.addEventListener('pointermove',e=>{if(!down)return;dx=e.clientX-sx;el.style.transform=`translateX(${dx}px) rotate(${dx/14}deg)`;
    el.querySelector('.stamp.like').style.opacity=Math.min(1,Math.max(0,dx/80));el.querySelector('.stamp.nope').style.opacity=Math.min(1,Math.max(0,-dx/80));});
  const up=()=>{if(!down)return;down=false;el.classList.remove('dragging');if(Math.abs(dx)>90){swipe(dx>0?1:-1);}else{el.style.transform='';el.querySelectorAll('.stamp').forEach(s=>s.style.opacity=0);}dx=0;};
  el.addEventListener('pointerup',up);el.addEventListener('pointercancel',up);
}


/* ---- profile sheet ---- */
const sheet=document.getElementById('sheet'),sheetScroll=document.getElementById('sheetScroll');
function openSheet(p){
  const img=document.getElementById('phImg');img.src=p.img;img.alt=p.role+' portfolio by '+p.handle;img.onerror=()=>onFail(img);
  document.getElementById('phFit').innerHTML='<i></i>'+fit(p)+'% style fit';
  document.getElementById('phHandle').textContent=p.handle;
  document.getElementById('phRole').textContent=p.role;
  document.getElementById('phLoc').innerHTML=PIN+p.loc;
  document.getElementById('phRate').textContent=p.rate;
  document.getElementById('phUnit').textContent=p.unit;
  document.getElementById('phAvail').textContent=p.avail;
  document.getElementById('phBio').textContent=p.bio;
  document.getElementById('phPort').innerHTML=p.port.map((src,k)=>`<figure><div class="pph"><img src="${src}" alt="" loading="lazy" onerror="this.style.visibility='hidden'"></div><span>${p.handle.replace('@','')}_0${k+1}.jpg</span></figure>`).join('');
  document.getElementById('phTags').innerHTML=p.tags.map(t=>`<span class="tag${p.role===svc?' hit':''}">${t}</span>`).join('');
  sheetScroll.scrollTop=0;sheet.classList.add('open');
}
function closeSheet(){sheet.classList.remove('open');}
document.getElementById('sheetClose').addEventListener('click',closeSheet);
document.getElementById('phPass').addEventListener('click',()=>{closeSheet();setTimeout(()=>swipe(-1),250);});
document.getElementById('phLike').addEventListener('click',()=>{closeSheet();setTimeout(()=>swipe(1),250);});
sheetScroll.addEventListener('scroll',()=>{if(sheetScroll.scrollTop<-60)closeSheet();});

function finale(){
  const p=likes[likes.length-1];
  document.getElementById('mImg').src=p.img;
  document.getElementById('mFile').textContent=p.handle.replace('@','').replace(/\./g,'_')+'.jpg';
  document.getElementById('mHandle').textContent=p.handle;
  document.getElementById('mMeta').textContent=p.role+' · '+p.loc;
  const freq={};likes.forEach(l=>l.tags.forEach(t=>freq[t]=(freq[t]||0)+1));
  document.getElementById('mStyle').textContent=Object.entries(freq).sort((a,b)=>b[1]-a[1]).slice(0,3).map(x=>x[0]).join(' · ');
  document.getElementById('mEvt').textContent='your '+evt.value.trim().toLowerCase();
  document.getElementById('mCount').textContent=likes.length;
  const st=document.getElementById('stars');st.innerHTML='';
  [[8,18],[84,14],[12,58],[88,60],[50,9],[28,36],[72,42]].forEach(([x,y],i)=>{const s=document.createElement('span');s.textContent='✳';s.style.left=x+'%';s.style.top=y+'%';s.style.animationDelay=(i*.08)+'s';st.appendChild(s);});
  show(s3);
}
document.getElementById('msg').addEventListener('click',()=>{const b=document.getElementById('msg');b.textContent='Message sent';b.classList.remove('gold');b.style.background='var(--olive)';b.style.color='#fff';setTimeout(()=>{b.textContent='Send a message';b.classList.add('gold');b.style.background='';b.style.color='';},1800);});

/* ---- chat, booking, confirmation ---- */
const msgs=document.getElementById('msgs'),quick=document.getElementById('quick');
let matchP=null,chatDone=false,script=[],si=0;
function money(n){return '₱'+n.toLocaleString('en-PH');}
function num(r){return parseInt(r.replace(/[^\d]/g,''),10);}
function pkg(p){
  const base=num(p.rate);
  if(p.role==='Makeup Artist'||p.role==='Hairstylist'){const trial=Math.round(base*0.43/100)*100;return {l1:p.role==='Makeup Artist'?'Debut look':'Event style',p1:base,l2:'Trial session',p2:trial,name:(p.role==='Makeup Artist'?'Debut look + trial':'Event style + trial')};}
  if(p.role==='Photographer')return {l1:'Half-day coverage',p1:base,l2:'Same-day teaser edit',p2:2000,name:'Half-day coverage + teaser'};
  if(p.role==='Dressmaker')return {l1:'Custom gown',p1:base,l2:'3 fittings',p2:0,name:'Custom gown, 3 fittings'};
  return {l1:'Styling package',p1:base,l2:'Day-of setup crew',p2:5000,name:'Styling + day-of setup'};
}
function addMsg(who,text,t){const d=document.createElement('div');d.className='m '+who;d.innerHTML=text+`<time>${t||now()}</time>`;msgs.appendChild(d);msgs.scrollTop=msgs.scrollHeight;return d;}
function now(){const d=new Date();return d.getHours()%12||12;}
function nowT(){const d=new Date(),h=d.getHours(),m=d.getMinutes();return `${h%12||12}:${m<10?'0':''}${m} ${h<12?'AM':'PM'}`;}
function typing(ms){return new Promise(r=>{const t=document.createElement('div');t.className='typing';t.innerHTML='<i></i><i></i><i></i>';msgs.appendChild(t);msgs.scrollTop=msgs.scrollHeight;setTimeout(()=>{t.remove();r();},ms);});}
function buildScript(p){
  const k=pkg(p),first=p.handle.replace('@','').split('.')[0],ev=evt.value.trim().toLowerCase();
  const tot=k.p1+k.p2;
  return [
    {me:`Hi ${first}! We matched for my ${ev} on Nov 22. Looking for ${p.tags[0].toLowerCase()}, medyo ${p.tags[1].toLowerCase()}, and something that lasts the whole night.`},
    {them:`Hi! Congrats on the ${ev}. Nov 22 is open on my end. Daytime or evening?`},
    {me:`Evening, 6 PM at Blue Leaf Cosmopolitan. Pictorial at 3 PM.`},
    {them:`Perfect. Let's start at 12:30 so you're camera-ready by 3. ${k.p2?'Do you want a trial first? I always recommend it for a big one.':'I can send a mood board draft this week so we lock the direction early.'}`},
    {me:k.p2?`Yes please! Magkano lahat?`:`That works. Magkano lahat?`},
    {them:`${k.l1} ${money(k.p1)}${k.p2?` + ${k.l2.toLowerCase()} ${money(k.p2)} = ${money(tot)}`:''}. Travel to Taguig included. 30% deposit holds the date, balance on the day.`},
    {me:`Deal. Trial on Nov 8, Saturday?`},
    {them:`Nov 8, 10 AM works. Sending the booking proposal now so it's all in one place.`},
    {proposal:true}
  ];
}
function quickFor(){quick.innerHTML='';if(chatDone)return;const opts=script[si]&&script[si].me?[script[si].me]:[];opts.forEach(t=>{const b=document.createElement('button');b.textContent=t.length>34?t.slice(0,32)+'…':t;b.addEventListener('click',()=>step(t));quick.appendChild(b);});}
async function step(text){
  if(chatDone)return;
  const cur=script[si];
  if(cur&&cur.me){addMsg('me',text||cur.me,nowT());si++;}
  quick.innerHTML='';
  while(script[si]&&!script[si].me){
    const c=script[si];
    if(c.them){await typing(900+Math.random()*600);addMsg('them',c.them,nowT());}
    if(c.proposal){await typing(700);renderProposal();}
    si++;
  }
  if(!script[si])chatDone=true;
  quickFor();
}
function renderProposal(){
  const k=pkg(matchP),tot=k.p1+k.p2,dep=Math.round(tot*0.3);
  const d=document.createElement('div');d.className='proposal';
  d.innerHTML=`<span class="k">booking proposal</span><b>${k.name}</b>
  <div class="line"><span>Sat, 22 Nov · call time 12:30 PM</span><em>Blue Leaf, Taguig</em></div>
  ${k.p2?`<div class="line"><span>Trial · Sat, 8 Nov · 10 AM</span><em>${money(k.p2)}</em></div>`:''}
  <div class="line"><span>Total</span><em>${money(tot)}</em></div>
  <div class="line"><span>Deposit to hold the date</span><em>${money(dep)}</em></div>
  <button class="btn brick" id="reviewBk">Review &amp; book</button>`;
  msgs.appendChild(d);msgs.scrollTop=msgs.scrollHeight;
  d.querySelector('#reviewBk').addEventListener('click',()=>openBooking());
  document.getElementById('chatStatus').textContent='proposal sent · awaiting your confirmation';
}
function openChat(p){
  matchP=p;const first=p.handle.replace('@','');
  const av=document.getElementById('chatAv');av.src=p.img;av.onerror=()=>onFail(av);
  document.getElementById('chatName').textContent=p.handle;
  document.getElementById('chatStatus').textContent='matched · usually replies in 1h';
  msgs.innerHTML='<div class="day">matched today · '+first+' · '+p.role+'</div>';
  script=buildScript(p);si=0;chatDone=false;
  show(s4);quickFor();
}
document.getElementById('compose').addEventListener('submit',e=>{e.preventDefault();const v=document.getElementById('compIn').value.trim();if(!v)return;document.getElementById('compIn').value='';if(script[si]&&script[si].me){step(v);}else{addMsg('me',v,nowT());}});
document.getElementById('chatBack').addEventListener('click',()=>show(s3));
document.getElementById('msg').replaceWith(document.getElementById('msg').cloneNode(true));
document.getElementById('msg').addEventListener('click',()=>openChat(likes[likes.length-1]));
document.getElementById('openChat2').addEventListener('click',()=>show(s4));

function openBooking(){
  const p=matchP,k=pkg(p),tot=k.p1+k.p2,dep=Math.round(tot*0.3);
  const av=document.getElementById('bkAv');av.src=p.img;av.onerror=()=>onFail(av);
  document.getElementById('bkName').textContent=p.handle;document.getElementById('bkRole').textContent=p.role+' · '+p.loc;
  document.getElementById('bkEvt').textContent=evt.value.trim();
  document.getElementById('bkPkg').textContent=k.name;
  document.getElementById('bkL1').textContent=k.l1;document.getElementById('bkP1').textContent=money(k.p1);
  document.getElementById('bkL2').textContent=k.l2;document.getElementById('bkP2').textContent=k.p2?money(k.p2):'included';
  document.getElementById('bkTot').textContent=money(tot);document.getElementById('bkDep').textContent=money(dep);
  show(s5);
}
document.querySelectorAll('.pay .opt').forEach(o=>o.addEventListener('click',()=>{document.querySelectorAll('.pay .opt').forEach(x=>x.setAttribute('aria-checked','false'));o.setAttribute('aria-checked','true');}));
document.getElementById('bookBack').addEventListener('click',()=>show(s4));
document.getElementById('confirmBtn').addEventListener('click',()=>{
  const b=document.getElementById('confirmBtn');b.disabled=true;b.textContent='Processing…';
  setTimeout(()=>{b.disabled=false;b.textContent='Confirm & pay deposit';
    const p=matchP,k=pkg(p),tot=k.p1+k.p2,dep=Math.round(tot*0.3);
    document.getElementById('refNo').textContent='OK-2026-'+String(1000+Math.floor(Math.random()*9000));
    document.getElementById('refLine').textContent=p.handle+' · '+evt.value.trim()+' · 22 Nov';
    document.getElementById('tl1').textContent=money(dep)+' via GCash · balance '+money(tot-dep)+' on the day';
    document.getElementById('tl3').textContent=p.handle;
    const st=document.getElementById('stars2');st.innerHTML='';
    [[6,6],[90,8],[14,30],[86,34]].forEach(([x,y],i)=>{const e=document.createElement('span');e.textContent='✳';e.style.left=x+'%';e.style.top=y+'%';e.style.animationDelay=(i*.08)+'s';st.appendChild(e);});
    show(s6);
    addMsg('them','Deposit received. Nov 22 is yours. See you at the trial on the 8th!',nowT());
    document.getElementById('chatStatus').textContent='booked · Nov 22';
  },900);
});
document.getElementById('restart').addEventListener('click',()=>{likes=[];history=[];idx=0;show(s1);});

document.getElementById('again').addEventListener('click',()=>{likes=[];show(s2);render();});
})();
</script>
</body>
</html>

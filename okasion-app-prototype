<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>okasion — app prototype</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{
  --paper:#F7F7F5;--white:#fff;--cacao:#3B2A22;--ink2:#6A574D;--line:rgba(59,42,34,.14);
  --brick:#A8342F;--mustard:#E0B84C;--olive:#3F5A32;--blush:#F2C4C4;--blue:#BFD7F2;
  --hard:4px 4px 0 var(--cacao);--soft:0 1px 2px rgba(59,42,34,.12),0 18px 40px -18px rgba(59,42,34,.4);
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{background:#EFEDE6;font-family:Inter,system-ui,sans-serif;color:var(--cacao);display:grid;place-items:center;padding:24px;-webkit-font-smoothing:antialiased;
  background-image:linear-gradient(rgba(59,42,34,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(59,42,34,.05) 1px,transparent 1px);background-size:32px 32px}
button{font:inherit;color:inherit;cursor:pointer;background:none;border:0}
:focus-visible{outline:3px solid var(--blue);outline-offset:3px}
h1,h2{font-family:"Bricolage Grotesque",sans-serif;font-weight:800;letter-spacing:-.03em;line-height:.98}
h1 em,h2 em,.serif{font-family:"Instrument Serif",Georgia,serif;font-style:italic;font-weight:400;letter-spacing:0}
.mono{font-family:"Space Mono",monospace;font-size:11px;letter-spacing:.03em}
.logo{height:22px;width:auto;display:block}
.hint{position:fixed;left:24px;bottom:22px;font-family:"Space Mono",monospace;font-size:11px;color:var(--ink2)}
.hint b{display:inline-block;border:1px solid var(--ink2);border-radius:4px;padding:1px 6px;margin:0 2px;font-weight:400}
.tape{position:absolute;width:84px;height:22px;left:50%;top:-11px;transform:translateX(-50%) rotate(-3deg);background:rgba(191,215,242,.6);backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px);box-shadow:inset 0 0 0 1px rgba(255,255,255,.5);z-index:3;pointer-events:none}
.tape.blush{background:rgba(242,196,196,.65);transform:translateX(-50%) rotate(4deg)}
.tape.mustard{background:rgba(224,184,76,.6);transform:translateX(-50%) rotate(-5deg)}

/* ---------- phone ---------- */
.phone{width:390px;height:844px;background:var(--paper);border-radius:52px;border:10px solid #2A2320;box-shadow:0 40px 80px -30px rgba(59,42,34,.6),0 0 0 1px rgba(0,0,0,.35);position:relative;overflow:hidden}
.notch{position:absolute;left:50%;top:12px;transform:translateX(-50%);width:120px;height:34px;background:#1A1311;border-radius:20px;z-index:60}
.status{position:absolute;top:19px;left:28px;right:28px;display:flex;justify-content:space-between;font-family:"Space Mono",monospace;font-size:12px;z-index:59}
.screen{position:absolute;inset:0;display:flex;flex-direction:column;opacity:0;pointer-events:none;transform:translateX(24px);transition:opacity .35s,transform .35s cubic-bezier(.2,.8,.2,1)}
.screen.active{opacity:1;pointer-events:auto;transform:none}
.btn{height:56px;border-radius:999px;border:2px solid var(--cacao);background:var(--white);font-weight:600;font-size:15px;display:flex;align-items:center;justify-content:center;gap:8px;box-shadow:var(--hard);transition:transform .12s,box-shadow .12s}
.btn:hover{transform:translate(2px,2px);box-shadow:2px 2px 0 var(--cacao)} .btn:active{transform:translate(4px,4px);box-shadow:none}
.btn.brick{background:var(--brick);color:var(--white)} .btn.gold{background:var(--mustard)}
.kicker{display:inline-flex;align-items:center;gap:8px;font-family:"Space Mono",monospace;font-size:11px;color:var(--brick)}
.kicker::before{content:"";width:18px;height:2px;background:var(--brick)}

/* ---------- screen 1 ---------- */
.onb{padding:70px 26px 28px;gap:14px}
.onb .head{display:flex;justify-content:space-between;align-items:center}
.onb .art{position:relative;height:200px;margin:4px 0 0}
.onb .pola{position:absolute;background:var(--white);padding:7px 7px 24px;box-shadow:var(--soft);width:108px;transform:rotate(var(--r,0))}
.onb .pola img{width:100%;aspect-ratio:4/5;object-fit:cover;display:block;background:var(--blush)}
.onb .pola span{position:absolute;left:8px;bottom:7px;font-family:"Space Mono",monospace;font-size:9px;color:var(--ink2)}
.onb h1{font-size:42px}
.onb h1 em{color:var(--brick)}
.onb p{color:var(--ink2);font-size:14px;max-width:32ch;margin-top:-4px}
.field{display:grid;gap:8px}
.field label{font-family:"Space Mono",monospace;font-size:11px;color:var(--ink2)}
.input{height:52px;border-radius:14px;background:var(--white);border:1.5px solid var(--cacao);padding:0 16px;font:inherit;font-size:16px;color:var(--cacao);width:100%;transition:box-shadow .15s}
.input::placeholder{color:rgba(59,42,34,.4)}
.input:focus{outline:none;box-shadow:var(--hard)}
.chipgrp{display:flex;flex-wrap:wrap;gap:8px}
.chip{height:38px;padding:0 14px;border-radius:999px;border:1.5px solid var(--cacao);background:var(--white);font-size:13px;font-weight:500;transition:background .15s,color .15s,transform .1s}
.chip:active{transform:scale(.97)}
.chip[aria-checked="true"]{background:var(--cacao);color:var(--white)}
.err{font-family:"Space Mono",monospace;font-size:11px;color:var(--brick);min-height:14px;margin-top:-8px}
.onb .btn{margin-top:auto}

/* ---------- screen 2 ---------- */
.topbar{position:absolute;top:0;left:0;right:0;height:110px;padding:60px 20px 0;display:flex;align-items:center;justify-content:space-between;z-index:20;
  background:linear-gradient(180deg,rgba(247,247,245,.95),rgba(247,247,245,.7) 75%,transparent);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);mask:linear-gradient(#000 75%,transparent);-webkit-mask:linear-gradient(#000 75%,transparent)}
.topbar .ttl{text-align:center;display:grid;gap:2px}
.topbar .ttl b{font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:17px;letter-spacing:-.02em}
.topbar .ttl span{font-family:"Instrument Serif",Georgia,serif;font-style:italic;font-size:14px;color:var(--ink2)}
.icon{width:40px;height:40px;border-radius:50%;border:1.5px solid var(--cacao);background:var(--white);display:grid;place-items:center;box-shadow:2px 2px 0 var(--cacao)}
.icon:active{transform:translate(1px,1px);box-shadow:1px 1px 0 var(--cacao)}
.icon svg{width:18px;height:18px;stroke:var(--cacao);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.stack{position:absolute;left:22px;right:22px;top:118px;bottom:154px}
.card{position:absolute;inset:0;background:var(--white);padding:10px 10px 0;box-shadow:var(--soft);transform-origin:50% 100%;transition:transform .5s cubic-bezier(.2,.8,.2,1),opacity .5s;will-change:transform;touch-action:none;user-select:none;display:flex;flex-direction:column;border-radius:4px}
.card .ph{flex:1;overflow:hidden;background:var(--blush);position:relative;min-height:0}
.card img{width:100%;height:100%;object-fit:cover;pointer-events:none;display:block}
.card .cap{padding:14px 6px 14px;display:grid;gap:8px}
.card .cap .row{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
.card h2{font-size:22px}
.card .loc{font-family:"Space Mono",monospace;font-size:10px;color:var(--ink2);display:inline-flex;align-items:center;gap:4px;white-space:nowrap}
.pin{width:11px;height:11px;fill:none;stroke:var(--ink2);stroke-width:2}
.card .role{font-family:"Instrument Serif",Georgia,serif;font-style:italic;font-size:14px;color:var(--ink2);margin-top:-4px}
.tags{display:flex;flex-wrap:wrap;gap:6px}
.tag{font-family:"Space Mono",monospace;font-size:10px;text-transform:uppercase;letter-spacing:.04em;padding:5px 9px;border-radius:999px;border:1.5px solid var(--brick);color:var(--brick);background:var(--white)}
.tag.hit{background:var(--brick);color:var(--white)}
.card .fit{position:absolute;top:12px;left:12px;font-family:"Space Mono",monospace;font-size:10px;background:var(--white);border:1.5px solid var(--cacao);padding:5px 9px;border-radius:999px;box-shadow:2px 2px 0 var(--cacao)}
.card .fit i{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--olive);margin-right:6px}
.card .stamp{position:absolute;top:22px;font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:26px;letter-spacing:.02em;padding:5px 12px;border:3px solid;border-radius:6px;opacity:0;transition:opacity .15s;pointer-events:none;background:rgba(255,255,255,.85);z-index:2}
.card .stamp.like{right:20px;color:var(--olive);border-color:var(--olive);transform:rotate(14deg)}
.card .stamp.nope{left:20px;color:var(--brick);border-color:var(--brick);transform:rotate(-14deg)}
.card.pos1{transform:translateY(12px) rotate(2.5deg) scale(.97)}
.card.pos2{transform:translateY(24px) rotate(-3deg) scale(.94)}
.card.gone-l{transform:translate(-140%,40px) rotate(-22deg);opacity:0}
.card.gone-r{transform:translate(140%,40px) rotate(22deg);opacity:0}
.card.dragging{transition:none}
.dock{position:absolute;left:0;right:0;bottom:40px;display:flex;justify-content:center;align-items:center;gap:22px;z-index:20}
.dock button{border-radius:50%;display:grid;place-items:center;border:2px solid var(--cacao);box-shadow:var(--hard);transition:transform .12s,box-shadow .12s}
.dock button:hover{transform:translate(2px,2px);box-shadow:2px 2px 0 var(--cacao)} .dock button:active{transform:translate(4px,4px);box-shadow:none}
.dock .pass{width:62px;height:62px;background:var(--blush);color:var(--brick)}
.dock .like{width:76px;height:76px;background:var(--olive);color:var(--white)}
.dock .undo{width:44px;height:44px;background:var(--white);color:var(--ink2);box-shadow:2px 2px 0 var(--cacao)}
.dock svg{width:26px;height:26px;stroke:currentColor;fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
.dock .like svg{fill:currentColor;stroke:none;width:32px;height:32px}
.dock .undo svg{width:16px;height:16px;stroke-width:2}
.counter{position:absolute;left:0;right:0;bottom:18px;text-align:center;font-family:"Space Mono",monospace;font-size:10px;color:var(--ink2);z-index:20}
.empty{position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:40px;color:var(--ink2);font-size:14px;font-family:"Instrument Serif",Georgia,serif;font-style:italic;font-size:20px}
.toast{position:absolute;left:50%;top:122px;transform:translateX(-50%) translateY(-10px);background:var(--cacao);color:var(--paper);padding:9px 14px;border-radius:999px;font-size:12px;opacity:0;transition:opacity .25s,transform .25s;z-index:30;pointer-events:none;white-space:nowrap}
.toast.show{opacity:1;transform:translateX(-50%)}

/* ---------- screen 3 ---------- */
.match{padding:76px 26px 30px;align-items:center;text-align:center;gap:14px;background:var(--paper)}
.match .stars{position:absolute;inset:0;pointer-events:none}
.match .stars span{position:absolute;color:var(--brick);font-size:26px;animation:pop .9s cubic-bezier(.2,.8,.2,1) both}
.match .stars span:nth-child(even){color:var(--mustard)}
@keyframes pop{from{transform:scale(0) rotate(-30deg);opacity:0}to{transform:scale(1) rotate(0);opacity:1}}
.match .kicker{margin-top:14px}
.match h1{font-size:44px}
.pair{position:relative;height:210px;width:100%;margin:8px 0}
.pair .av{position:absolute;top:8px;width:150px;background:var(--white);padding:8px 8px 30px;box-shadow:var(--soft)}
.pair .av .ph{aspect-ratio:4/5;overflow:hidden;background:var(--blush)}
.pair .av img{width:100%;height:100%;object-fit:cover;display:block}
.pair .av span{position:absolute;left:8px;bottom:8px;font-family:"Space Mono",monospace;font-size:9px;color:var(--ink2)}
.pair .you{left:calc(50% - 152px);transform:rotate(-7deg)}
.pair .you .ph{display:grid;place-items:center;background:var(--blue)}
.pair .you svg{width:64px;height:64px;fill:var(--cacao);opacity:.5}
.pair .them{left:calc(50% + 2px);transform:rotate(7deg);z-index:2}
.pair .heart{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);z-index:3;width:54px;height:54px;border-radius:50%;background:var(--mustard);border:2px solid var(--cacao);display:grid;place-items:center;box-shadow:var(--hard);animation:beat 1.2s ease-in-out infinite}
.pair .heart svg{width:24px;height:24px;fill:var(--cacao)}
@keyframes beat{0%,100%{transform:translate(-50%,-50%) scale(1)}50%{transform:translate(-50%,-50%) scale(1.1)}}
.match .who b{font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:20px;display:block}
.match .who span{font-family:"Instrument Serif",Georgia,serif;font-style:italic;color:var(--ink2);font-size:15px}
.match .sum{background:var(--white);border:1.5px dashed var(--cacao);border-radius:12px;padding:12px 14px;font-size:12px;color:var(--ink2);width:100%;display:grid;gap:6px;text-align:left}
.match .sum b{color:var(--cacao);font-weight:600}
.match .btn{width:100%;margin-top:auto}
.match .link{color:var(--ink2);font-size:13px;text-decoration:underline;text-underline-offset:4px}
.match .logo{height:18px;opacity:.9}

/* ---------- profile sheet ---------- */
.card .rate{position:absolute;top:12px;right:12px;font-family:"Space Mono",monospace;font-size:10px;background:var(--mustard);border:1.5px solid var(--cacao);padding:5px 9px;border-radius:999px;box-shadow:2px 2px 0 var(--cacao)}
.card .more{display:inline-flex;align-items:center;gap:6px;font-family:"Space Mono",monospace;font-size:10px;color:var(--brick);text-decoration:underline;text-underline-offset:3px;margin-top:2px}
.card .more svg{width:12px;height:12px;stroke:currentColor;fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
.sheet{position:absolute;inset:0;z-index:40;background:var(--paper);transform:translateY(100%);transition:transform .45s cubic-bezier(.2,.8,.2,1);display:flex;flex-direction:column}
.sheet.open{transform:none}
.sheet .close{position:absolute;top:58px;left:18px;z-index:5}
.sheet .scroll{flex:1;overflow-y:auto;overscroll-behavior:contain;scrollbar-width:none;padding-bottom:120px}
.sheet .scroll::-webkit-scrollbar{display:none}
.sheet .hero{position:relative;aspect-ratio:4/5;background:var(--blush);overflow:hidden}
.sheet .hero img{width:100%;height:100%;object-fit:cover;display:block}
.sheet .hero .grad{position:absolute;inset:0;background:linear-gradient(180deg,rgba(247,247,245,.5),transparent 25%,transparent 60%,rgba(247,247,245,1))}
.sheet .hero .fit{position:absolute;bottom:18px;left:18px;font-family:"Space Mono",monospace;font-size:10px;background:var(--white);border:1.5px solid var(--cacao);padding:5px 9px;border-radius:999px;box-shadow:2px 2px 0 var(--cacao)}
.sheet .hero .fit i{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--olive);margin-right:6px}
.sheet .body{padding:0 22px;display:grid;gap:22px;margin-top:-6px;position:relative;z-index:2}
.sheet .name h2{font-size:30px}
.sheet .name .role{font-family:"Instrument Serif",Georgia,serif;font-style:italic;font-size:17px;color:var(--ink2);display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.sheet .name .loc{font-family:"Space Mono",monospace;font-size:10px;color:var(--ink2);display:inline-flex;align-items:center;gap:4px}
.ratebox{background:var(--white);border:1.5px solid var(--cacao);border-radius:14px;padding:14px 16px;display:grid;grid-template-columns:1fr auto;gap:4px 12px;align-items:center;box-shadow:var(--hard)}
.ratebox b{font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:26px;letter-spacing:-.02em;grid-row:span 2}
.ratebox span{font-family:"Space Mono",monospace;font-size:10px;color:var(--ink2);text-align:right}
.ratebox .av{color:var(--olive)}
.sheet h3{font-family:"Space Mono",monospace;font-size:11px;font-weight:400;color:var(--brick);letter-spacing:.04em;display:flex;align-items:center;gap:8px;margin-bottom:10px}
.sheet h3::before{content:"";width:18px;height:2px;background:var(--brick)}
.sheet p{font-size:14px;line-height:1.55;color:var(--cacao)}
.port{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.port figure{background:var(--white);padding:6px 6px 22px;box-shadow:var(--soft);position:relative;transform:rotate(var(--r,0))}
.port figure:nth-child(1){--r:-2deg;grid-column:span 2}.port figure:nth-child(2){--r:1.5deg}.port figure:nth-child(3){--r:-1deg}.port figure:nth-child(4){--r:2deg}.port figure:nth-child(5){--r:-1.5deg}
.port .pph{background:var(--blush);aspect-ratio:1;overflow:hidden}
.port figure:nth-child(1) .pph{aspect-ratio:16/10}
.port img{width:100%;height:100%;object-fit:cover;display:block}
.port span{position:absolute;left:6px;bottom:5px;font-family:"Space Mono",monospace;font-size:9px;color:var(--ink2)}
.sheet .tags .tag{font-size:11px;padding:7px 11px}
.sheet .note{background:var(--mustard);border:1.5px solid var(--cacao);padding:12px 14px;font-size:13px;transform:rotate(-1deg);box-shadow:var(--hard)}
.sheet .note b{font-family:"Instrument Serif",Georgia,serif;font-style:italic;font-weight:400;font-size:18px;display:block;margin-bottom:2px}
.sheet .actions{position:absolute;left:0;right:0;bottom:0;padding:16px 22px 34px;background:linear-gradient(180deg,transparent,var(--paper) 35%);display:flex;gap:12px;z-index:5}
.sheet .actions .btn{flex:1;height:52px}
.sheet .actions .btn.blush{background:var(--blush);color:var(--brick)}
.sheet .actions .btn.olive{background:var(--olive);color:var(--white)}

/* ---------- chat ---------- */
.chat{background:var(--paper)}
.chat .bar{position:absolute;top:0;left:0;right:0;height:112px;padding:58px 18px 0;display:flex;align-items:center;gap:12px;z-index:5;background:linear-gradient(180deg,var(--paper) 80%,transparent)}
.chat .bar .av{width:40px;height:40px;border-radius:50%;overflow:hidden;background:var(--blush);border:1.5px solid var(--cacao);flex:none}
.chat .bar .av img{width:100%;height:100%;object-fit:cover}
.chat .bar .who{flex:1;min-width:0}
.chat .bar .who b{font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:16px;display:block;letter-spacing:-.02em}
.chat .bar .who span{font-family:"Space Mono",monospace;font-size:10px;color:var(--olive)}
.msgs{position:absolute;top:112px;bottom:92px;left:0;right:0;overflow-y:auto;padding:8px 18px 20px;display:flex;flex-direction:column;gap:10px;scrollbar-width:none}
.msgs::-webkit-scrollbar{display:none}
.day{align-self:center;font-family:"Space Mono",monospace;font-size:10px;color:var(--ink2);background:var(--white);border:1px dashed var(--cacao);padding:3px 10px;border-radius:999px;margin:4px 0 6px}
.m{max-width:78%;padding:11px 14px;font-size:14px;line-height:1.45;border-radius:18px;animation:in .3s ease both;position:relative}
@keyframes in{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.m.them{align-self:flex-start;background:var(--white);border:1.5px solid var(--cacao);border-bottom-left-radius:4px}
.m.me{align-self:flex-end;background:var(--cacao);color:var(--paper);border-bottom-right-radius:4px}
.m time{display:block;font-family:"Space Mono",monospace;font-size:9px;opacity:.6;margin-top:4px}
.typing{align-self:flex-start;background:var(--white);border:1.5px solid var(--cacao);border-radius:18px;border-bottom-left-radius:4px;padding:12px 14px;display:flex;gap:4px}
.typing i{width:6px;height:6px;border-radius:50%;background:var(--ink2);animation:dot 1s infinite}
.typing i:nth-child(2){animation-delay:.15s}.typing i:nth-child(3){animation-delay:.3s}
@keyframes dot{0%,100%{opacity:.3;transform:translateY(0)}50%{opacity:1;transform:translateY(-3px)}}
.proposal{align-self:stretch;background:var(--white);border:1.5px solid var(--cacao);border-radius:14px;padding:14px 16px;box-shadow:var(--hard);display:grid;gap:8px;animation:in .3s ease both;margin-top:4px}
.proposal .k{font-family:"Space Mono",monospace;font-size:10px;color:var(--brick);display:flex;align-items:center;gap:8px}
.proposal .k::before{content:"";width:16px;height:2px;background:var(--brick)}
.proposal b{font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:18px;letter-spacing:-.02em}
.proposal .line{display:flex;justify-content:space-between;font-size:13px;color:var(--ink2);border-top:1px dashed var(--line);padding-top:6px}
.proposal .line em{font-style:normal;color:var(--cacao);font-weight:600}
.proposal .btn{height:46px;font-size:14px;margin-top:4px}
.compose{position:absolute;left:0;right:0;bottom:0;padding:12px 16px 28px;display:flex;gap:10px;background:linear-gradient(180deg,transparent,var(--paper) 30%)}
.compose input{flex:1;height:48px;border-radius:999px;border:1.5px solid var(--cacao);background:var(--white);padding:0 16px;font:inherit;font-size:14px}
.compose input:focus{outline:none;box-shadow:var(--hard)}
.compose button{width:48px;height:48px;border-radius:50%;background:var(--brick);color:#fff;border:1.5px solid var(--cacao);box-shadow:2px 2px 0 var(--cacao);display:grid;place-items:center}
.compose button svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
.quick{position:absolute;left:0;right:0;bottom:92px;padding:0 16px 6px;display:flex;gap:8px;overflow-x:auto;scrollbar-width:none}
.quick::-webkit-scrollbar{display:none}
.quick button{white-space:nowrap;height:34px;padding:0 12px;border-radius:999px;border:1.5px solid var(--cacao);background:var(--white);font-size:12px;font-weight:500}
.quick button:active{background:var(--blue)}

/* ---------- booking ---------- */
.book{padding:60px 0 0;background:var(--paper)}
.book .bar{padding:0 18px;display:flex;align-items:center;gap:12px;height:52px}
.book .bar h2{font-size:20px}
.book .scroll{flex:1;overflow-y:auto;padding:10px 22px 130px;display:grid;gap:18px;align-content:start;scrollbar-width:none}
.book .scroll::-webkit-scrollbar{display:none}
.stub{background:var(--white);border:1.5px solid var(--cacao);border-radius:14px;position:relative;box-shadow:var(--hard)}
.stub .top{padding:16px 18px;display:flex;gap:12px;align-items:center;border-bottom:1.5px dashed var(--cacao)}
.stub .top .av{width:46px;height:46px;border-radius:8px;overflow:hidden;background:var(--blush);flex:none}
.stub .top .av img{width:100%;height:100%;object-fit:cover}
.stub .top b{font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:17px;display:block;letter-spacing:-.02em}
.stub .top span{font-family:"Instrument Serif",Georgia,serif;font-style:italic;color:var(--ink2);font-size:14px}
.stub::before,.stub::after{content:"";position:absolute;width:18px;height:18px;border-radius:50%;background:var(--paper);border:1.5px solid var(--cacao);left:-10px;top:66px}
.stub::after{left:auto;right:-10px}
.stub dl{padding:14px 18px;display:grid;grid-template-columns:1fr 1fr;gap:12px 14px}
.stub dt{font-family:"Space Mono",monospace;font-size:10px;color:var(--ink2);margin-bottom:2px}
.stub dd{font-size:14px;font-weight:500}
.stub dd small{display:block;font-weight:400;color:var(--ink2);font-size:12px}
.tot{background:var(--white);border:1.5px solid var(--cacao);border-radius:14px;padding:14px 18px;display:grid;gap:8px}
.tot .row{display:flex;justify-content:space-between;font-size:14px;color:var(--ink2)}
.tot .row.big{border-top:1.5px dashed var(--cacao);padding-top:10px;color:var(--cacao);font-weight:600}
.tot .row.big b{font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:22px;letter-spacing:-.02em}
.tot .row.dep{background:var(--mustard);margin:4px -18px -14px;padding:12px 18px;border-radius:0 0 12px 12px;color:var(--cacao);font-weight:600}
.pay{display:grid;gap:8px}
.pay h3{font-family:"Space Mono",monospace;font-size:11px;font-weight:400;color:var(--brick)}
.pay .opts{display:flex;gap:8px}
.pay .opt{flex:1;height:44px;border-radius:12px;border:1.5px solid var(--cacao);background:var(--white);font-size:13px;font-weight:600;display:flex;align-items:center;justify-content:center;gap:6px}
.pay .opt[aria-checked="true"]{background:var(--cacao);color:var(--white)}
.terms{font-size:12px;color:var(--ink2);line-height:1.5}
.book .actions{position:absolute;left:0;right:0;bottom:0;padding:16px 22px 34px;background:linear-gradient(180deg,transparent,var(--paper) 35%)}
.book .actions .btn{width:100%}

/* ---------- confirmed ---------- */
.done{padding:64px 22px 30px;background:var(--paper);gap:14px}
.done .stars{position:absolute;inset:0;pointer-events:none}
.done .stars span{position:absolute;color:var(--brick);font-size:22px;animation:pop .9s cubic-bezier(.2,.8,.2,1) both}
.done .stars span:nth-child(even){color:var(--mustard)}
.done .scroll{flex:1;overflow-y:auto;display:grid;gap:16px;align-content:start;scrollbar-width:none;padding-bottom:110px}
.done .scroll::-webkit-scrollbar{display:none}
.done h1{font-size:40px}
.ref{background:var(--white);border:1.5px solid var(--cacao);border-radius:14px;padding:16px 18px;display:grid;grid-template-columns:1fr auto;gap:6px 12px;align-items:center;box-shadow:var(--hard);transform:rotate(-1deg)}
.ref .k{font-family:"Space Mono",monospace;font-size:10px;color:var(--ink2)}
.ref b{font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:18px;letter-spacing:-.02em}
.ref .stampok{grid-row:span 2;width:64px;height:64px;border-radius:50%;border:2px solid var(--olive);color:var(--olive);display:grid;place-items:center;font-family:"Space Mono",monospace;font-size:9px;text-align:center;line-height:1.1;transform:rotate(12deg)}
.ref .stampok::after{content:"";position:absolute;inset:4px;border:1px dashed var(--olive);border-radius:50%}
.ref .stampok{position:relative}
.tl{display:grid;gap:0;position:relative;padding-left:26px}
.tl::before{content:"";position:absolute;left:9px;top:8px;bottom:8px;border-left:2px dashed var(--cacao);opacity:.4}
.tl li{list-style:none;position:relative;padding:0 0 18px}
.tl li::before{content:"";position:absolute;left:-23px;top:4px;width:14px;height:14px;border-radius:50%;background:var(--white);border:2px solid var(--cacao)}
.tl li.ok::before{background:var(--olive);border-color:var(--olive)}
.tl li.now::before{background:var(--mustard)}
.tl b{font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:15px;display:block;letter-spacing:-.01em}
.tl span{font-size:13px;color:var(--ink2);display:block}
.tl small{font-family:"Space Mono",monospace;font-size:10px;color:var(--olive)}
.done .actions{position:absolute;left:0;right:0;bottom:0;padding:16px 22px 34px;background:linear-gradient(180deg,transparent,var(--paper) 35%);display:grid;gap:10px}
.done .actions .link{text-align:center;color:var(--ink2);font-size:13px;text-decoration:underline;text-underline-offset:4px}
@media(max-height:900px){body{padding:10px}.phone{transform:scale(.92);transform-origin:top center}}
</style>
</head>
